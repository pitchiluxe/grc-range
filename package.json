{
  "name": "grc-range",
  "type": "module",
  "version": "1.1.0",
  "description": "GRC Range — a simulated Windows Server 2022 desktop for practicing Governance, Risk, and Compliance audits, risk assessment, and remediation.",
  "engines": {
    "node": ">=22"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "electron:dev": "vite build && tsc -p electron/tsconfig.json && electron .",
    "electron:build": "vite build && tsc -p electron/tsconfig.json && electron-builder",
    "electron:build:win": "vite build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:mac": "vite build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "electron:build:linux": "vite build && tsc -p electron/tsconfig.json && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "author": {
    "name": "Erick Omari"
  },
  "license": "MIT",
  "build": {
    "appId": "com.pitchiluxe.grc-range",
    "productName": "GRC Range",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/package.json",
      "electron/dist/**/*",
      "dist/**/*",
      "public/favicon.ico",
      "public/icon.svg"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GRC Range"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.svg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.svg"
    },
    "publish": {
      "provider": "github",
      "owner": "pitchiluxe",
      "repo": "grc-range"
    }
  }
}
